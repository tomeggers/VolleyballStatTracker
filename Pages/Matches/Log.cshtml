@page "{setId:int}"
@model VolleyballStatTracker.Pages.Matches.LogModel
@using VolleyballStatTracker.Models
@{
    ViewData["Title"] = "Log stats";

    // The action pad, one row per skill: our point on the left, rally continues in the middle, their point on the right.
    var padRows = new (string Skill, (StatType Type, string Label)?[] Actions)[]
    {
        ("Attack", [(StatType.Kill, "Kill"), (StatType.AttackInPlay, "In play"), (StatType.AttackError, "Error")]),
        ("Serve", [(StatType.ServiceAce, "Ace"), (StatType.ServeInPlay, "In play"), (StatType.ServiceError, "Error")]),
        ("Block", [(StatType.BlockSolo, "Solo"), (StatType.BlockAssist, "Assist"), null]),
        ("Defence", [(StatType.Dig, "Dig"), (StatType.Assist, "Set assist"), null]),
    };
    var last = Model.LastEntry;
}

@section Styles {
    <link rel="stylesheet" href="~/css/log.css" asp-append-version="true" />
}

<div class="match-header">
    <span>vs <strong>@Model.Match.Opponent</strong> &middot; @Model.Match.Date.ToString("d MMM")</span>
    <span>Sets <strong id="sets-score">@Model.SetsWon&ndash;@Model.SetsLost</strong></span>
    @if (Model.Match.IsFinished)
    {
        <span class="finished-badge">Finished</span>
    }
</div>

<nav class="set-tabs" aria-label="Sets">
    @foreach (var s in Model.SetSummaries)
    {
        <a asp-page="Log" asp-route-setId="@s.SetId" asp-route-playerId="@Model.SelectedPlayerId"
           class="set-tab @(s.SetId == Model.CurrentSet.Id ? "active" : "") @(s.Result == SetResult.Won ? "won" : s.Result == SetResult.Lost ? "lost" : "")"
           aria-current="@(s.SetId == Model.CurrentSet.Id ? "page" : null)">
            Set @s.SetNumber <small>@s.Us&ndash;@s.Them</small>
        </a>
    }
</nav>

@if (Model.Match.IsFinished)
{
    <div class="scoreboard">
        <span class="us">US <b>@Model.Current.Us</b></span><span class="dash">&ndash;</span><span class="them"><b>@Model.Current.Them</b> OPP</span>
    </div>
    <p class="text-center">This match is finished, so logging is off.</p>
    <form method="post" asp-page-handler="ReopenMatch" asp-route-setId="@Model.CurrentSet.Id" class="match-actions">
        <button type="submit" class="btn-act btn-none">Reopen match</button>
    </form>
}
else
{
    <form id="log-form" method="post" asp-page-handler="LogStat" asp-route-setId="@Model.CurrentSet.Id"
          data-set-over="@(Model.IsSetOver ? "true" : "false")">

        <div class="log-sticky">
            <div class="scoreboard" aria-live="polite">
                <span class="us">US <b id="score-us">@Model.Current.Us</b></span><span class="dash">&ndash;</span><span class="them"><b id="score-them">@Model.Current.Them</b> OPP</span>
            </div>

            <button type="submit" id="opp-point" class="btn-act btn-them opp-point"
                    asp-page-handler="OpponentPoint" asp-route-setId="@Model.CurrentSet.Id"
                    data-scores="true" disabled="@Model.IsLocked(StatType.OpponentPoint)">
                Opponent point <small>their kill / ace</small>
            </button>

            <div id="last-entry-bar" class="last-entry" data-effect="@(last is null ? "none" : LogModel.Effect(last.StatType, last.Grade))">
                <span id="last-entry">@(last is null ? "No entries yet" : Model.Describe(last))</span>
                <button type="submit" id="undo" class="undo"
                        asp-page-handler="Undo" asp-route-setId="@Model.CurrentSet.Id"
                        disabled="@(last is null)">Undo</button>
            </div>

            <p id="status" class="status" role="status" hidden></p>
        </div>

        <p id="set-over" class="set-over" hidden="@(!Model.IsSetOver)">
            Set <span id="set-over-result">@(Model.Current.Result == SetResult.Won ? "won" : "lost")</span>.
            Score buttons are locked; assists and digs still count. Wrong score? Undo.
        </p>

        @if (Model.Players.Count == 0)
        {
            <p class="text-center"><a asp-page="/Players/Index">Add your players</a> to start logging stats.</p>
        }

        <fieldset class="player-grid">
            <legend class="visually-hidden">Player</legend>
            @foreach (var player in Model.Players)
            {
                <input type="radio" class="btn-check" name="playerId" id="p-@player.Id" value="@player.Id"
                       data-label="#@player.ShirtNumber @LogModel.ShortName(player)"
                       checked="@(Model.SelectedPlayerId == player.Id)" />
                <label class="tile" for="p-@player.Id">
                    <span class="num">@player.ShirtNumber</span>
                    <span class="name">@LogModel.ShortName(player)</span>
                </label>
            }
        </fieldset>

        <div class="pad">
            <div id="acting" class="acting">Pick a player first</div>

            @foreach (var row in padRows)
            {
                <div class="pad-row">
                    <span class="skill">@row.Skill</span>
                    @foreach (var action in row.Actions)
                    {
                        if (action is { } a)
                        {
                            var effect = LogModel.Effect(a.Type);
                            <button type="submit" class="btn-act btn-@effect"
                                    asp-page-handler="LogStat" asp-route-setId="@Model.CurrentSet.Id" asp-route-statType="@a.Type"
                                    data-scores="@(LogModel.Scores(a.Type) ? "true" : "false")" data-needs-player="true"
                                    disabled="@Model.IsLocked(a.Type)">
                                @a.Label
                                @if (effect != "none")
                                {
                                    <span class="effect">+1 @effect</span>
                                }
                            </button>
                        }
                        else
                        {
                            <span></span>
                        }
                    }
                </div>
            }

            <div class="pad-row reception">
                <span class="skill">Pass</span>
                @for (var grade = 0; grade <= 3; grade++)
                {
                    var effect = LogModel.Effect(StatType.Reception, grade);
                    <button type="submit" class="btn-act btn-@effect grade"
                            asp-page-handler="LogStat" asp-route-setId="@Model.CurrentSet.Id"
                            asp-route-statType="@StatType.Reception" asp-route-grade="@grade"
                            data-scores="@(LogModel.Scores(StatType.Reception, grade) ? "true" : "false")" data-needs-player="true"
                            disabled="@Model.IsLocked(StatType.Reception, grade)"
                            aria-label="Reception grade @grade">
                        @grade
                        @if (grade == 0)
                        {
                            <span class="effect">+1 them</span>
                        }
                    </button>
                }
            </div>
        </div>
    </form>

    <div class="match-actions">
        @if (Model.HasNextSet)
        {
            <form method="post" asp-page-handler="NextSet" asp-route-setId="@Model.CurrentSet.Id">
                <button type="submit" class="btn-act btn-none">Go to set @(Model.CurrentSet.SetNumber + 1) &rarr;</button>
            </form>
        }
        else if (Model.CurrentSet.SetNumber < StatRules.MaxSets)
        {
            <form id="next-set" method="post" asp-page-handler="NextSet" asp-route-setId="@Model.CurrentSet.Id" hidden="@(!Model.CanAddSet)">
                <button type="submit" class="btn-act btn-none">Start set @(Model.CurrentSet.SetNumber + 1) &rarr;</button>
            </form>
        }
        <form method="post" asp-page-handler="EndMatch" asp-route-setId="@Model.CurrentSet.Id"
              onsubmit="return confirm('End the match? You can reopen it later.');">
            <button type="submit" class="btn-act btn-end">End match</button>
        </form>
    </div>
}

@section Scripts {
    <script src="~/js/log.js" asp-append-version="true"></script>
}
