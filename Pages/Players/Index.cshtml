@page
@model VolleyballStatTracker.Pages.Players.IndexModel
@{
    ViewData["Title"] = "Players";
}

<h1>Players</h1>

<ul>
    @foreach (var player in Model.Players)
    {
        <li>#@player.ShirtNumber &ndash; @player.Name</li>
    }
</ul>

<h2>Add a player</h2>

<form method="post">
    <label>
        Name
        <input asp-for="NewName" />
        <span asp-validation-for="NewName" class="text-danger"></span>
    </label>
    <label>
        Shirt number
        <input asp-for="NewShirtNumber" type="number" min="0" max="99" />
        <span asp-validation-for="NewShirtNumber" class="text-danger"></span>
    </label>
    <button type="submit">Add</button>
</form>
